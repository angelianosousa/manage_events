{
  "name": "manage_events",
  "version": "1.0.0",
  "description": "Gerenciar seu evento ficou mais fácil",
  "main": "application.js",
  "directories": {
    "lib": "lib",
    "app": "app"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.4.21",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.89.2",
    "select2": "^4.1.0-rc.0"
  },
  "devDependencies": {},
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "npm run build:css:compile && npm run build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"npm run build:css\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelianosousa/manage_events.git"
  },
  "author": "Angeliano Sousa",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/angelianosousa/manage_events/issues"
  },
  "homepage": "https://github.com/angelianosousa/manage_events#readme"
}
