{
  "name": "manage_events",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "scripts": {
    "build": "yarn build:css && yarn build:js",
    "build:css": "sass app/assets/stylesheets:app/assets/builds --no-source-map --load-path=node_modules",
    "watch:css": "yarn build:css --watch",
    "build:js": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "watch:js": "yarn build:js --watch"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jquery": "^3.7.1",
    "jquery-mask-plugin": "^1.14.16",
    "sass": "^1.93.2",
    "select2": "^4.1.0-rc.0",
    "vanilla-nested": "^1.7.1"
  },
  "resolutions": {
    "jquery": "^3.7.1"
  }
}
