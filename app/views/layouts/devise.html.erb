<!DOCTYPE html>
<html>
  <head>
    <title>ManageEvents</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "devise", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "devise", "data-turbo-track": "reload", defer: true %>
  </head>

  <body id="body_gradient">
    <div style="position: absolute; top: 15%; left: 37%;">
      <div class="d-flex align-items-center justify-content-center text-white">
        <%= bootstrap_icon(icon: 'bi-building-fill', style: 'font-size: 3em;') %>
        
        <h5>Gerência de <br>Eventos</h5>
      </div>

      <div class='card'>
        <div class="card-body" style="width: 400px;">
          <%= yield %>
        </div>
      </div>
    </div>

  </body>
</html>
