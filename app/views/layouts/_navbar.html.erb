<header class="p-3 border-bottom">
  <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
    <span class="badge text bg-dark p-2">
      <%= bootstrap_icon('', 'bi-building-fill') %>
    </span>

    <div class="ms-3 me-1 mb-0 pb-0">
      <h5>Sistema de Gerenciamento</h5>

      <p style="font-size: 12px; margin-bottom: 0px;">Eventos, Produtos e Pedidos</p>
    </div>

    <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
      <li class="mx-1">
        <%= link_to company_home_index_path, class: "btn btn-outline-primary btn-sm #{controller_name == 'home' ? 'active' : ''}" do %>
          <i class="bi bi-clipboard-data"></i> Dashboard
        <% end %>
        
      </li>
      <li class="mx-1">
        <%= link_to company_events_path, class: "btn btn-outline-primary btn-sm #{controller_name == 'events' ? 'active' : ''}" do %>
          <i class="bi bi-calendar-event"></i> Eventos
        <% end %>
      </li>

      <li class="mx-1">
        <%= link_to '#', class: "btn btn-outline-primary btn-sm #{controller_name == 'products' ? 'active' : ''}" do %>
          <%= bootstrap_icon(' Produtos', 'bi-box-seam') %>
        <% end %>
      </li>

      <li class="mx-1">
        <%= link_to '#', class: "btn btn-outline-primary btn-sm #{controller_name == 'orders' ? 'active' : ''}" do %>
          <i class="bi bi-cart"></i> Pedidos
        <% end %>
      </li>
    </ul>
    
    <div class="dropdown text-end">

      <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"> 
        <div class="d-inline-flex">
          <div>
            <p class="me-3 mb-0"><%= current_admin.name %></p>
            <p style="font-size: 12px;"><%= current_admin.email %></p>
          </div>

          <img src="https://github.com/mdo.png" alt="mdo" width="40" height="40" class="rounded-circle"> 
        </div>
      </a>

      <ul class="dropdown-menu text-small" style="">
        <li><a class="dropdown-item" href="#">New project...</a></li>
        <li><a class="dropdown-item" href="#">Settings</a></li>
        <li><a class="dropdown-item" href="#">Profile</a></li>
        <li>
          <hr class="dropdown-divider">
        </li>
        <li>
          <%= button_to 'Sair', destroy_admin_session_path, class: 'dropdown-item', method: :delete %>
        </li>
      </ul>
    </div>
  </div>
</header>