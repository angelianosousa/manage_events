<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:event_title) || 'Titulo do evento' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "event_page", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "event_page", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag 'https://code.jquery.com/jquery-3.7.1.min.js', integrity: 'sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=', crossorigin: 'anonymous' %>
  </head>

  <body id="body_bg_event">
    <%= render 'company_module/shared/navbar' if company_admin_signed_in? %>

    <%= yield %>
  </body>
</html>
