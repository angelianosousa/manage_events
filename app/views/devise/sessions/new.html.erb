<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <h3>Log in</h3>

  <div class="form-floating"> 
    <%= f.email_field :email, class: 'form-control', autofocus: true, autocomplete: "email" %>
    <%= f.label :email, for: 'admin_email' %>
  </div>
  
  <div class="form-floating">
    <%= f.password_field :password, class: 'form-control', autocomplete: "current-password" %>
    <%= f.label :password, for: 'admin_password' %>
  </div>

  <div class="text-center">
    <small class="text-danger my-2"><%= alert %></small>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-check text-start my-3">
      <%= f.check_box :remember_me, class: 'form-check-input' %>
      <%= f.label :remember_me, class: 'form-check-label', for: 'admin_remember_me' %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Entrar", class: 'btn btn-primary btn-round w-100 mt-2' %>
  </div>
  
<% end %>

<%= render "devise/shared/links" %>

<div class="d-flex justify-content-center">
  <p class="text-body-secondary">© <%= Date.today.year %></p>
</div>
