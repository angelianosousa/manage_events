<% if notice.present? %>
  <div class="alert alert-success d-flex align-items-center alert-dismissible py-3 mt-4 fade show" role="alert">
    <p>
      <%= bootstrap_icon(icon: 'bi bi-check-circle-fill me-2') %>
      <%= notice %>
    </p>

    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
