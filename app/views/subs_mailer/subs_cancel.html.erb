<table role="presentation" align="center" style="width: 96%; width: 600px;">
  <% content_for :header_mail do %>
    <table style="height: 150px; width: 100%; text-align: center; color: #fff; background-color: rgba(220, 53, 69)" align="center">
      <tr>
        <td>
          <h2 style="text-align: center;">Inscrição Cancelada!</h2>
          
          <%= image_tag 'icon_check.png', alt: "check-icon-img", style:"width: 40px;" %>
        </td>
      </tr>
    </table>
  <% end %>

  <tr>
    <td>
      <table style="width: 600px; margin-top: 20px;">
        <tr>
          <td>
            <div style="text-align: center;">
              <h2>Olá <%= @client.name %></h2>

              <p>Confirmamos o cancelamento da sua inscrição no evento.<br>Lamentamos que você não possa participar desta vez.</p>
            </div>

            <div style="padding: 20px; background-color: #f8d7da; border: 1px solid #f1aeb5;">
              <p style="font-size: 20px; font-weight: bold; text-align: center; color: rgba(220,53,69);">Detalhes do Cancelamento</p>

              <table align='center' valign="top">
                <tbody>
                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Nº Inscrição:</b></td>
                    <td>#<%= "#{@event.id}.#{@payment.id}.#{@client.id}" %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Data Cancelamento</b></td>
                    <td><%= I18n.l @payment.cancelled_at, format: :short %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Evento:</b></td>
                    <td><%= @event.name %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Data do evento:</b></td>
                    <td>
                      <%= I18n.l @event.date_start, format: :short %> -
                      <%= @event.time_start.strftime('%H:%m') %> às <%= @event.time_end.strftime('%H:%m') %>
                    </td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Ingresso:</b></td>
                    <td><%= @payment.ticket.name %> - <%= humanized_money_with_symbol @payment.ticket.price %></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div style="text-align: center; margin-top: 20px;">
              <div style="padding: 10px; border-left: 5px solid; color: rgba(13, 110, 253); background-color: #cfe2ff">
                <p style="font-size: 20px; font-weight: bold;">Interessado em outros eventos?</p>

                <p>Temos outros eventos incríveis acontecendo em breve. Confira nossa programação completa e encontre o evento perfeito para você!</p>
              </div>
            </div>
            
            <div style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
              <%= link_to 'Ver Outros Eventos', @url_all_events, target: "_blank", style: 'display: block; background-color: rgba(13, 110, 253); color: #fff; margin: 30px 200px; padding: 10px; border-radius: 10px; text-decoration: none;' %>

              <small>Sentiremos sua falta! Esperamos vê-lo(a) em um próximo evento.</small>
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <% content_for :footer_mail do %>
    <table style="height: 120px; width: 100%; text-align: center; background-color: rgba(233, 236, 239)">
      <tr>
        <td>
          <p>Dúvidas sobre o cancelamento ? Contate-nos em <%= ENV.fetch('DEFAULT_MAIL', 'geventos@gmail.com')%></p>

          <small>© <%= Date.today.year %> GEventos. Todos os direitos reservados.</small><br>
          
          <small>Esse é um email automatico, não responda</small>
        </td>
      </tr>
    </table>
  <% end %>
</table>
