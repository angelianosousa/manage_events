<table role="presentation" align="center" style="width: 96%; width: 600px;">
  <% content_for :header_mail do %>
    <table style="text-align: center; background: linear-gradient(135deg, #10b981 0%, #059669 100%); height: 150px; width: 100%; color: #fff;" align="center">
      <tr>
        <td>
          <h3 style="text-align: center;">Pagamento Confirmado!</h3>
          
          <%= image_tag 'icon_check.png', alt: "check-icon-img", style:"width: 40px;" %>
        </td>
      </tr>
    </table>
  <% end %>

  <tr>
    <td>
      <table style="width: 600px; margin-top: 20px;">
        <tr>
          <td>
            <div style="text-align: center; margin: 20px 0px;">
              <h5>Olá <%= @client.name %></h5>

              <p>Ótimas notícias! Seu pagamento foi processado com sucesso e sua vaga no evento está garantida.</p>
            </div>

            <div style="padding: 20px; margin-bottom: 20px; background-color: #d1e7dd; border: 1px solid #a3cfbb;">
              <p style="font-size: 24px; font-weight: bold; text-align: center; color: rgba(25,135,84)">Comprovante de Pagamento</p>

              <table align='center' style="text-align: center;">
                <tbody>
                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Nº Transação:</b></td>
                    <td>#<%= "#{@event.id}.#{@payment.id}.#{@client.id}" %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Data Pagamento:</b></td>
                    <td><%= I18n.l @event.date_start, format: :short %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Ingresso:</b></td>
                    <td><%= @payment.ticket.name %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Valor do ingresso:</b></td>
                    <td><%= humanized_money_with_symbol @payment.ticket.price %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Quantidade:</b></td>
                    <td><%= @payment.quantity %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 60px;"><b>Valor total:</b></td>
                    <td><%= @payment.quantity %> x <%= humanized_money_with_symbol @payment.ticket.price %> = <%= humanized_money_with_symbol @payment.price %></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div style="padding: 20px; text-align: center; background-color: rgba(233, 236, 239)">
              <h4 style="font-size: 24px; font-weight: bold; text-align: center; color: rgba(25,135,84)">Detalhes do Evento</h4>

              <table align='center' valign="top" style="text-align: center;">
                <tbody>
                  <tr class="text-secondary">
                    <td style="padding-right: 30px;"><b>Evento:</b></td>
                    <td><%= I18n.l @event.date_start, format: :short %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 30px;"><b>Horário:</b></td>
                    <td><%= @event.time_start.strftime('%H:%m') %> - <%= @event.time_end.strftime('%H:%m') %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 30px;"><b>Local:</b></td>
                    <td style="width: 300px;"><%= @event.full_event_address %></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div style="text-align: center; margin-top: 20px;">
              <div style="padding: 15px; border-left: 5px solid; background-color: #fff3cd; color: #664d03;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 15px;"></i>

                <b>Importante:</b> Guarde este e-mail como comprovante. Apresente-o no dia do evento junto com um documento de identificação.
              </div>
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <% content_for :footer_mail do %>
    <table style="text-align: center; height: 120px; width: 100%; margin-top: 20px; background-color: rgba(233, 236, 239)">
      <tr>
        <td>
          <p>Dúvidas ? Entre em contato conosco em <%= ENV.fetch('DEFAULT_MAIL', 'geventos@gmail.com')%></p>

          <small>© <%= Date.today.year %> GEventos. Todos os direitos reservados.</small><br>
          
          <small>Esse é um email automatico, não responda</small>
        </td>
      </tr>
    </table>
  <% end %>
</table>
