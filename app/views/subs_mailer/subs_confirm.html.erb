<table role="presentation" align="center" style="width: 96%; width: 600px;">
  <% content_for :header_mail do %>
    <table style="text-align: center; color: #fff; background-color: #031633; height: 150px; width: 100%;" align="center">
      <tr>
        <td>
          <h2 style="text-align: center; color: #fff;">Inscrição Registrada!</h2>
          
          <%= image_tag 'icon_check.png', alt: "check-icon-img", style:"width: 40px;" %>
        </td>
      </tr>
    </table>
  <% end %>

  <tr>
    <td>
      <table style="width: 600px; margin-top: 20px;">
        <tr>
          <td>
            <div style="text-align: center;">
              <h3>Olá <%= @client.name %></h3>

              <p>Sua inscrição para o evento foi registrada com sucesso! Estamos muito felizes em tê-lo(a) conosco</p>
            </div>

            <div style="padding: 20px; background-color: rgba(233, 236, 239);">
              <h4 style="color: #031633; font-weight: bold; text-align: center;">Detalhes do Evento</h4>

              <table align='center' valign="top">
                <tbody>
                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Evento:</b></td>
                    <td><%= @event.name %></td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Data:</b></td>
                    <td>
                      <%= I18n.l @event.date_start, format: :short %> -
                      <%= @event.time_start.strftime('%H:%m') %> às <%= @event.time_end.strftime('%H:%m') %>
                    </td>
                  </tr>

                  <tr class="text-secondary">
                    <td style="padding-right: 85px;"><b>Local:</b></td>
                    <td style="width: 200px;"><%= @event.full_event_address %></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
              <h3>Próximos passos</h3>

              <p>
                Aguarde a confirmação do pagamento para finalizar sua inscrição. <br>
                Você receberá um novo e-mail assim que o pagamento for processado.
              </p>

              <a href="<%= @payment.link %>" target="_blank"
              style="display: block; border: 1px solid black; border-radius: 10px; padding: 10px 3px; text-decoration: none; color: black; margin: 30px 150px;"
              >CONFIRME SUA INSCRIÇÃO</a>

              <small>Se já realizou o pagamento desconside</small>
            </div>

          </td>
        </tr>
      </table>
    </td>
  </tr>

  <% content_for :footer_mail do %>
    <table style="text-align: center; height: 120px; width: 100%; margin-top: 20px; background-color: rgba(233, 236, 239)">
      <tr>
        <td>
          <p>Dúvidas ? Entre em contato conosco em <%= ENV.fetch('DEFAULT_MAIL', 'geventos@gmail.com')%></p>

          <small>© <%= Date.today.year %> GEventos. Todos os direitos reservados.</small><br>
          
          <small>Esse é um email automatico, não responda</small>
        </td>
      </tr>
    </table>
  <% end %>
</table>
