<%= content_for :event_title do %>
  <%= @event&.name %>
<% end %>

<div class="container-fluid bg-light">
  <header class="d-flex flex-wrap justify-content-center align-items-center border-bottom py-3">
    <%= link_to company_event_page_path(params[:company], @event), class: 'd-flex align-items-center mb-md-0 me-md-auto text-decoration-none h4' do %>
      <span><%= @event.name %></span>
    <% end %>

    <% if admin_signed_in? %>
      <ul class="nav nav-pills">
        <li class="nav-item"><%= link_to_edit_resource(' Editar', edit_company_event_path(@event.id), size: 'btn-sm') %></li>

        <li class="nav-item">
          <%= link_to company_event_path(@event), class: 'btn btn-light btn-sm' do %>
            <%= bootstrap_icon(text: ' Voltar', icon: 'bi-arrow-left-circle-fill') %>
          <% end %>
        </li>
      </ul>
    <% end %>
  </header>
</div>

<main>
  <section class="container text-center my-3">
    <div class="figure" style='opacity: 0.7; background-position: center center;'>
      <% image = @event.banner&.image&.attached? ? @event.banner.image : 'placeholder.png'%>

      <%= image_tag image, class: 'figure-img img-fluid', style: 'width: 1320px; height: 300px;' %>
    </div>
  </section>

  <div class="container">
    <%= render '/shared/error_messages', resource: @payment %>

    <div class='row'>
      <div class='col-sm-8 col-md-8 mb-3'>

        <div class='card p-0'>
          <div class='card-body'>

            <h5>Informações do evento</h5>

            <div class="row g-2">
              <div class="col-md-4 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-calendar-date', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Data</b> <br>
                    <%= I18n.l @event.date_start, format: :long %> <br>
                  </p>
                </div>
              </div>

              <div class="col-sm-3 col-md-3 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-clock', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Horário</b><br>
                    <%= @event.time_start.strftime('%H:%m') %> -
                    <%= @event.time_end.strftime('%H:%m') %>
                  </p>
                </div>
              </div>

              <div class="col-sm-5 col-md-5 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-geo-alt', style: 'font-size: 2em;') %>
                  
                  <p class="ms-2">
                    <b>Local</b><br>
                    <%= @event.local_name %> <br>
                  </p>
                </div>
              </div>

            </div>

          </div>
        </div>

        <div class="card my-4">
          <div class="card-body">
            <h5>Sobre o evento</h5>

            <%= @event.description %>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h5>Organizador do evento</h5>

            <div class="d-flex align-items-start">
              <%= image_tag 'placeholder.png', size: '65x65', class: 'img-fluid', style: 'border-radius: 50%;' %>

              <p class="ms-3">
                <b><%= @event.company.name %></b> <br>

                <small>Organizamos os melhores eventos do país</small>
              </p>
            </div>

            <div class="row">
              <div class="col-sm-4 col-md-4">
                <%= link_to 'mailto:contato@techevents.com.br', class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-envelope') %> contato@techevents.com.br
                <% end %>
              </div>
              <div class="col-sm-4 col-md-4">
                <%= link_to 'telto:+55 11 99999-9999', class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-telephone') %> +55 11 99999-9999
                <% end %>
              </div>
              <div class="col-sm-4 col-md-4">
                <%= link_to 'https://techevents.com.br', target: '_blank', class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-globe') %> https://techevents.com.br
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class='col-sm-4 col-md-4'>
        <%= render 'form_buy_ticket', event: @event %>
      </div>
    </div> 
    
  </div>
</main>

<footer class="text-body-secondary py-5">
  <div class="container">
    <p class="float-end mb-1"> <a href="#">Back to top</a> </p>
    <p class="mb-1">Album example is &copy; Bootstrap, but please download and customize it for yourself!</p>
    <p class="mb-0">New to Bootstrap? <a href="/">Visit the homepage</a> or read our <a href="../getting-started/introduction">getting started guide</a>.</p>
  </div>
</footer>

