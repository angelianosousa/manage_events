<%= content_for :event_title do %>
  <%= @event&.name %>
<% end %>

<main>
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a href="<%= company_all_events_path %>" class="navbar-brand">
        <% image = @event.company.logo&.image&.attached? ? @event.company.logo.image : 'placeholder.png' %>

        <%= image_tag image, class: 'me-2 rounded-circle', size: '40x32' %>

        <span class="fs-4"><%= @event.company.name %></span>
      </a>

      <% if company_admin_signed_in? %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      <% end %>

      <div class="collapse navbar-collapse" id="navbarScroll">
        <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll float-end" style="--bs-scroll-height: 100px;">
          <li class="nav-item active">
            <a href="#" class="nav-link"></a>
          </li>

          <% if company_admin_signed_in? %>
            <li class="nav-item">
              <%= link_to edit_company_event_path(@event), class: 'nav-link' do %>
                <%= bootstrap_icon(text: ' Editar', icon: 'bi-pencil') %>
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to company_event_path(@event), class: 'nav-link' do %>
                <%= bootstrap_icon(text: ' Ver evento', icon: 'bi-eye') %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-3">
    <div class="banner-figure mb-3">
      <% image = @event.banner&.image&.attached? ? @event.banner.image : 'placeholder.png' %>

      <%= image_tag image, class: 'img-fluid rounded', style: 'width: 1320px; height: 300px;' %>
    </div>
  </div>

  <div class="container">

    <%= render '/shared/error_messages', resource: @payment %>

    <div class='row'>
      <div class='col-sm-8 col-md-8 mb-3'>

        <div class='card p-0'>
          <div class='card-body'>

            <h5>Informações do evento</h5>

            <div class="row g-2">
              <div class="col-md-4 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-calendar-date', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Data</b> <br>
                    <%= I18n.l @event.date_start, format: :short %> <br>
                  </p>
                </div>
              </div>

              <div class="col-sm-3 col-md-3 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-clock', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Horário</b><br>
                    <%= I18n.l @event.time_start, format: :only_hour %> -
                    <%= I18n.l @event.time_end, format: :only_hour %>
                  </p>
                </div>
              </div>

              <div class="col-sm-5 col-md-5 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-geo-alt', style: 'font-size: 2em;') %>
                  
                  <p class="ms-2">
                    <b>Local</b><br>
                    <%= @event.full_event_address %> <br>
                  </p>
                </div>
              </div>

            </div>

          </div>
        </div>

        <div class="card my-4">
          <div class="card-body">
            <h5>Sobre o evento</h5>

            <p class="d-flex">
              <% @event.categories.each do |cat| %>
                <span class="badge text-bg-dark me-1"><%= cat %></span>
              <% end %>
            </p>

            <%= @event.description %>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h5>Organizador do evento</h5>

            <div class="d-flex align-items-start">
              <%= image_tag @event.company.logo&.image&.attached? ? @event.company.logo.image : 'placeholder.png', size: '40x40', class: 'rounded-circle' %>

              <p class="ms-3">
                <b><%= @event.company.name %></b> <br>

                <small>Organizamos os melhores eventos do país</small>
              </p>
            </div>

            <div class="row">
              <% company = @event.company %>

              <div class="col-sm-4 col-md-4">
                <%= link_to "mailto:#{company.email}", class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-envelope') %> <%= company.email %>
                <% end if company.email.present? %>
              </div>
              <div class="col-sm-4 col-md-4">
                <%= link_to 'telto:+55 11 99999-9999', class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-telephone') %> <%= company.cellphone %>
                <% end if company.cellphone.present? %>
              </div>
              <div class="col-sm-4 col-md-4">
                <%= link_to 'https://techevents.com.br', target: '_blank', class: 'text-dark', style: 'text-decoration: none;' do %>
                  <%= bootstrap_icon(icon: 'bi-globe') %> <%= company.site %>
                <% end if company.site.present? %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class='col-sm-4 col-md-4'>
        <%= render 'subs_form', event: @event %>
      </div>
    </div> 
    
  </div>
</main>

<footer class="text-body-secondary mt-3">
  <div class="container">
    <p class="float-end mb-3"> 
      <%= link_to '#', class: 'btn btn-secondary' do %>
        <%= bootstrap_icon(icon: 'bi-chevron-up') %>
      <% end %>
    </p>
  </div>
</footer>

