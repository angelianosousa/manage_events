<%= content_for :event_title do %>
  <%= @event&.name %>
<% end %>

<div class="container-fluid">
  <header class="d-flex flex-wrap justify-content-center align-items-center py-3 border-bottom">
    <a href="/" class="d-flex align-items-center mb-md-0 me-md-auto link-body-emphasis text-decoration-none"> 
      <svg class="bi me-2" width="40" height="32" aria-hidden="true">
        <use xlink:href="#bootstrap"></use>
      </svg>
      <span class="h4">Eventos</span>
    </a>

    <% if admin_signed_in? %>
      <ul class="nav nav-pills">
        <li class="nav-item"><%= link_to_edit_resource(' Editar', edit_company_event_path(@event.id), size: 'btn-md') %></li>
        <li class="nav-item"><%= link_to_back('btn-md') %></li>
      </ul>
    <% end %>
  </header>
</div>

<main>
  <section class="text-center mb-5">
    <div class="row py-lg-5 banner_event" style="background-image: url('<%= @event&.banner&.image&.attached? ? url_for(@event&.banner&.image) : 'https://mdbcdn.b-cdn.net/img/new/fluid/nature/015.webp' %>'); background-repeat: no-repeat; background-position: center center; background-size: cover; opacity: 0.7; width: 100%; height: 300px;">
      <div class="col-lg-6 col-md-8 mx-auto">
        <h1 class="text-light"><%= @event.name %></h1>

        <p class="lead text-light">
          <%= @event.description %>
        </p>
      </div>
    </div>
  </section>

  <div class="container">
    <div class='row'>
      <div class='col-md-8'>

        <div class='card p-0'>
          <div class='card-body'>

            <h5>Informações do evento</h5>

            <div class="row g-2">
              <div class="col-md-4 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-calendar-date', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Data</b> <br>
                    <%= I18n.l @event.date_start, format: :long %> <br>
                    <%= I18n.l @event.date_end, format: :long %>
                  </p>
                </div>
              </div>

              <div class="col-md-3 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-clock', style: 'font-size: 2em;') %>

                  <p class="ms-2">
                    <b>Horário</b><br>
                    <%= @event.time_start.strftime('%H:%m') %> -
                    <%= @event.time_end.strftime('%H:%m') %>
                  </p>
                </div>
              </div>

              <div class="col-md-5 fs-6">
                <div class="d-flex align-items-start">
                  <%= bootstrap_icon(icon: 'bi-geo-alt', style: 'font-size: 2em;') %>
                  
                  <p class="ms-2">
                    <b>Local</b><br>
                    <%= @event.local_name %> <br>
                  </p>
                </div>
              </div>

            </div>

          </div>
        </div>

        <div class="card my-4">
          <div class="card-body">
            <h5>Sobre o evento</h5>

            <%= @event.description %>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h5>Organizador do evento</h5>

            <div class="d-flex align-items-start">
              <%= image_tag 'placeholder.png', size: '65x65', class: 'img-fluid', style: 'border-radius: 50%;' %>

              <p class="ms-3">
                <b><%= @event.company.name %></b> <br>

                <small>Organizamos os melhores eventos do país</small>
              </p>
            </div>

            <div class="d-flex justify-content-start ms-2">
              <%= link_to 'mailto:contato@techevents.com.br', class: 'text-dark', style: 'text-decoration: none;' do %>
                <%= bootstrap_icon(icon: 'bi-envelope') %> contato@techevents.com.br
              <% end %>

              <%= link_to 'telto:+55 11 99999-9999', class: 'text-dark mx-2', style: 'text-decoration: none;' do %>
                <%= bootstrap_icon(icon: 'bi-telephone') %> +55 11 99999-9999
              <% end %>

              <%= link_to 'https://techevents.com.br', target: '_blank', class: 'text-dark', style: 'text-decoration: none;' do %>
                <%= bootstrap_icon(icon: 'bi-globe') %> https://techevents.com.br
              <% end %>
            </div>
          </div>
        </div>

      </div>


      <div class='col-md-4'>
        <div class='card'>
          <div class='card-body'>
            <h5 class='card-title'>Ingressos</h5>

            <% @event.tickets.each do |ticket| %>
              <div class="card btn p-0 my-3" id="ticket_<%= ticket.id %>">
                <div class="card-body">
                  <div class="d-flex justify-content-between">
                    <h6 class="card-title"><%= ticket.name %></h6>

                    <b><%= humanized_money_with_symbol ticket.price %></b>
                  </div>

                  <hr>

                  <div class="d-flex justify-content-between align-items-center">
                    <small><%= ticket.ticket_payments.count %> de <%= ticket.quantity %> disponíveis</small>

                    <div class="progress" role="progressbar" aria-label="Warning example" aria-valuenow="<%= ticket.ticket_payments.count %>" aria-valuemin="0" aria-valuemax="<%= ticket.quantity %>" style="height: 5px; width: 50px;">
                      <div class="progress-bar bg-dark" style="width: <%= ticket.tickets_percentage[:total] %>%"></div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="form-group mt-4">
              <%= link_to '#', class: 'btn btn-light btn-sm', id: 'decrease' do %>
                <%= bootstrap_icon(icon: 'bi-dash') %>
              <% end %>

              <%= number_field_tag :payment_ticket, 1, class: 'fom-control', min: 1 %>

              <%= link_to '#', class: 'btn btn-light btn-sm', id: 'increase' do %>
                <%= bootstrap_icon(icon: 'bi-plus') %>
              <% end %>
            </div>

            <%= link_to 'Confirmar', '#', class: 'btn btn-dark btn-round w-100 mt-3' %>
          </div>
        </div>
      </div>
    </div> 
    
  </div>
</main>

<footer class="text-body-secondary py-5">
  <div class="container">
    <p class="float-end mb-1"> <a href="#">Back to top</a> </p>
    <p class="mb-1">Album example is &copy; Bootstrap, but please download and customize it for yourself!</p>
    <p class="mb-0">New to Bootstrap? <a href="/">Visit the homepage</a> or read our <a href="../getting-started/introduction">getting started guide</a>.</p>
  </div>
</footer>

<script>
  let btn = document.querySelector('#ticket_<%= @event.tickets.last.id %>');

  let dash_button   = document.querySelector('#decrease');
  let plus_button   = document.querySelector('#increase');
  let payment_field = document.querySelector('#payment_ticket');

  plus_button.addEventListener('click', function(){
    payment_field.stepUp(1);
  });

  dash_button.addEventListener('click', function(){
    payment_field.stepDown(1);
  });

  btn.addEventListener('click', function(){
    console.log('clicou!')
    btn.style.borderColor = 'black';
  });
</script>
