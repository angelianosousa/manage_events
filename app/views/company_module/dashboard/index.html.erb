<div class="row">
  <div class="col-7">
    <div class="card">
      <div class="card-body">
        <h5>Eventos em destaque</h5>

        <% if @events.any? %>
          <% @events.each do |event| %>
            <h6><%= event.name %></h6>

            <%= event_progress(event).html_safe %>
          <% end %>
        <% else %>
          <div class="text-left">Cadastre o primeiro evento...</div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col">
    <div class="card">
      <div class="card-body">
        <h5>Ações rápidas</h5>

        <%= link_to  new_company_event_path, class: 'd-flex flex-column btn btn-light' do %>
          <%= bootstrap_icon(icon: 'bi-calendar-plus fs-2') %>

          <span>Criar Evento</span>
          <small class="text-body-secondary">Adicione um novo evento</small>
        <% end %>

        <%= link_to  company_all_events_path, class: 'd-flex flex-column btn btn-light mt-3' do %>
          <%= bootstrap_icon(icon: 'bi-calendar3 fs-2') %>

          <span>Página de eventos</span>
          <small class="text-body-secondary">Veja seus eventos</small>
        <% end %>
      </div>
    </div>
  </div>
</div>
