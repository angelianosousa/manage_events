<%= form_with(model: [:company, event]) do |form| %>

  <%= render '/shared/error_messages', resource: event %>

  <div class="d-flex align-items-start">
    <div class="card me-3">
      <div class="card-body">
        <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
          <button class="nav-link active" id="v-pills-event-info-tab" data-bs-toggle="pill" data-bs-target="#v-pills-event-info" type="button" role="tab" aria-controls="v-pills-general-info" aria-selected="true">Geral</button>
          <button class="nav-link" id="v-pills-banner-tab" data-bs-toggle="pill" data-bs-target="#v-pills-banner" type="button" role="tab" aria-controls="v-pills-banner" aria-selected="false">Imagens</button>
          <button class="nav-link" id="v-pills-tickets-tab" data-bs-toggle="pill" data-bs-target="#v-pills-tickets" type="button" role="tab" aria-controls="v-pills-tickets" aria-selected="false"><%= Ticket.model_name.human.pluralize %></button>
        </div>
      </div>
    </div>
    
    <div class="tab-content w-100" id="v-pills-tabContent">
      <%= render 'company_module/events/form/event_info', f: form, event: event %>
      <%= render 'company_module/events/form/photos', f: form, event: event %>
      <%= render 'company_module/events/form/tickets', f: form %>

      <div class="actions mt-3">
        <%= form.submit 'Salvar', class: 'btn btn-dark' %>
        <%= link_to 'Cancelar', company_events_path, class: 'btn btn-default' %>
      </div>
    </div>

  </div>

<% end %>
