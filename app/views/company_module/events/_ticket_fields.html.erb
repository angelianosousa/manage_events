<div class="wrapper-div">
  
  <div class="float-right">
    <%= link_to_remove_nested(form, link_classes: 'btn btn-danger btn-sm', fields_wrapper_selector: '.wrapper-div') do %> <!-- adds a link to add more items -->
      <%= bootstrap_icon(text: ' Remover', icon: 'bi-trash') %>
    <% end %>
  </div>

  <div class="row g-2 mt-1">
    <div class="col-md-4">
      <div class="form-group">
        <%= form.label :name %>
        <%= form.text_field :name, class: 'form-control form-control-sm mb-3' %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="form-group">
        <%= form.label :quantity %>
        <%= form.number_field :quantity, class: 'form-control form-control-sm mb-3', min: 1 %>
      </div>
    </div>

    <div class="col-md-4">
      <%= form.label :price %>

      <div class="input-group input-group input-group-sm">
        <span class="input-group-text"><%= form.object.price.currency.html_entity %></span>
        
        <%= form.text_field :price, class: 'form-control form-control-sm' %>
      </div>
    </div>

    <div class="col-md-12">
      <div class="form-group">
        <%= form.label :description %>
        <%= form.text_field :description, class: 'form-control form-control-sm mb-3' %>
      </div>
    </div>

  </div>

</div>
