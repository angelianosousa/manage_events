<%= content_for :page_header do %>
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">

      <div class="navbar-brand">
        <h4 class="mb-0">
          <i class="bi bi-calendar-event" id="teste"></i> Eventos
        </h4>

        <small>Gerencie seus eventos</small>
      </div>

      <%= link_to_new_resource(' Novo evento', new_company_event_path, 'btn-dark') %>
    </div>
  </nav>
<% end %>

<%= render 'search_form' %>

<% if @events.any? %>
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @events.each do |event| %>

      <div class="col card-group">
        <div class="card">
          <div class="card-body">
            <div class="mb-3">
              <h5 class="card-title mb-0"><%= event.name %></h5>

              <div class="d-flex justify-content-between">
                <small class="mt-0"><span class="badge text-bg-secondary"><%= event.category_name %></span></small>
                
                <span>
                  <%= event_visibility(event) %>
                  <%= badge_status_event(event) %>
                </span>
              </div>
            </div>

            <div class="card-text mb-3">
              <% ticket = event.tickets.last %>

              <p style='font-size: 15px; margin-bottom: 0px; color: gray;'><%= bootstrap_icon(text: ' Inicio ', icon: 'bi-calendar-date') %><%= I18n.l event.date_start, format: :short %></p>
              <p style='font-size: 15px; margin-bottom: 0px; color: gray;'><%= bootstrap_icon(text: event.address.address_name, icon: 'bi-geo-alt') %></p>
              <p style='font-size: 15px; margin-bottom: 0px; color: gray;'><%= bootstrap_icon(text: " #{event.subscribers_sellout} de #{event.subscribers_expected} participantes", icon: 'bi-people') %></p>
            </div>
          </div>

          <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex flex-column">
                <% event.tickets.each do |ticket| %>
                  <small><%= ticket.name %>: <%= humanized_money_with_symbol ticket.price %></small>
                <% end %>
              </div>

              <div class="d-flex justify-content-right">
                <%= link_to_show_resource('', company_event_path(event.id)) %>
                <%= link_to_edit_resource('', edit_company_event_path(event.id)) %>
                <%= link_to_delete_resource('', company_event_path(event.id)) %>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% end %>
  </div>
<% else %>
  <p class="text-center">Sem eventos...</p>
<% end %>
