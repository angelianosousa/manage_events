<div class="tab-pane fade" id="v-pills-banner" role="tabpanel" aria-labelledby="v-pills-banner-tab" tabindex="0">
  
  <div class="card mb-3">
    <div class="card-body">
      <div class="figure">
        <% image = event.banner&.image&.attached? ? event.banner.image : 'placeholder.png'%>

        <%= image_tag image, class: 'figure-img img-fluid', style: 'width: 1320px; height: 300px;' %>
      </div>
      
      <%= f.fields_for :banner do |banner_form| %>
        <div class="d-inline-block">
          <%= banner_form.label :image, class: 'btn btn-light', for: 'event_banner_attributes_image' do %>
            <%= bootstrap_icon(icon: 'bi-cloud-upload') %> Escolher arquivo (1320x300)
          <% end %>

          <span id="file-name">
            Nenhum arquivo selecionado
          </span>
        </div>

        <%= banner_form.file_field :image, style: 'display: none;' %>
      <% end %>
    </div>
  </div>

</div>

<script>
  $('#event_banner_attributes_image').on('change', function(e) {
    const file = e.target.files[0]

    $('#file-name').html(file ? `<%= bootstrap_icon(icon: 'bi-file-check') %>  ${file.name}` : 'Nenhum arquivo selecionado')
  });
</script>
