<div class="tab-pane fade show active" id="v-pills-event-info" role="tabpanel" aria-labelledby="v-pills-event-info-tab" tabindex="0">

  <div class="card">
    <div class="card-body">
      <div class="card-title h6">
        <%= bootstrap_icon(text: ' Informações básicas', icon: 'bi-clipboard') %>
      </div>

      <div class="row mt-1">
        <div class="col-md">
          <div class="form-group">
            <%= f.label :name, style: "display: block" %>
            <%= f.text_field :name, class: 'form-control form-control-sm' %>
          </div>
        </div>

        <div class="col-md">
          <div class="form-group">
            <%= f.label :status, style: "display: block" %>
            <%= f.select :status, options_for_select(event_statuses_for_select, selected: event.status), {}, { class: 'form-select form-select-sm select2' } %>
          </div>
        </div>

        <div class="col-md">
          <div class="form-group">
            <%= f.label :categories, style: "display: block" %>
            <%= f.select :categories, options_for_select(event_category_list_for_select, selected: event.categories), 
                                            { multiple: true }, { class: 'form-select form-select-sm select2-multiple' } %>
          </div>
        </div>
      </div>
      
      <div class="form-group mt-3">
        <%= f.label :description, style: "display: block" %>
        <%= f.text_area :description, class: 'form-control form-control-sm mb-3', size: '10x7' %>
      </div>
    </div>
  </div>

  <div class="row my-3">
    <div class="col-md">
      <div class="card">
        <div class="card-body">
          <div class="card-title h6">
            <%= bootstrap_icon(text: ' Data e Horário', icon: 'bi-calendar') %>
          </div>

          <div class="row g-2 mb-2">
            <div class="col-md">
              <div class="form-group">
                <%= f.label :date_start, style: "display: block" %>
                <%= f.date_field :date_start, class: 'form-control form-control-sm' %>
              </div>
            </div>
          </div>

          <div class="row g-2">
            <div class="col-md">
              <div class="form-group">
                <%= f.label :time_start, style: "display: block" %>
                <%= f.time_field :time_start, class: 'form-control form-control-sm' %>
              </div>
            </div>

            <div class="col-md">
              <div class="form-group">
                <%= f.label :time_end, style: "display: block" %>
                <%= f.time_field :time_end, class: 'form-control form-control-sm' %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="col-md">
      <div class="card">
        <div class="card-body">
          <div class="card-title h6">
            <%= bootstrap_icon(text: ' Localização', icon: 'bi-geo-alt') %>
          </div>

          <%= f.fields_for :address do |address_form| %>

            <div class="input-loading mb-2">
              <%= address_form.label :zip_code, 'CEP', class: 'form-label' %>
              <%= address_form.text_field :zip_code, class: 'form-control form-control-sm cep-mask', placeholder: 'Digite o CEP' %>
              
              <%= image_tag 'loading.gif', alt: 'Carregando', width: '24', id: 'loading', style: 'display: none; margin-top: 5px;' %>
            </div>

            <small id="zip_not_found" style="color: red;">
              CEP não encontrado...
            </small>

            <div class="row">
              <div class="col-sm-8 col-md-8">
                <div class="form-group mb-2">
                  <%= address_form.label :street, 'Endereço *', class: 'form-label' %>
                  <%= address_form.text_field :street, class: 'form-control form-control-sm' %>
                </div>
              </div>

              <div class="col-sm-4 col-md-4">
                <div class="form-group mb-2">
                  <%= address_form.label :number, 'Nº', class: 'form-label' %>
                  <%= address_form.text_field :number, class: 'form-control form-control-sm' %>
                </div>
              </div>
            </div>

            <div class="form-group mb-2">
              <%= address_form.label :neighborhood, 'Bairro *', class: 'form-label' %>
              <%= address_form.text_field :neighborhood, class: 'form-control form-control-sm' %>
            </div>

            <div class="row">
              <div class="col-sm col-md">
                <div class="form-group mb-2">
                  <%= address_form.label :city, 'Cidade *', class: 'form-label' %>
                  <%= address_form.text_field :city, class: 'form-control form-control-sm' %>
                </div>
              </div>

              <div class="col-sm col-md">
                <div class="form-group mb-2">
                  <%= address_form.label :state, 'Estado (UF) *', class: 'form-label' %>
                  <%= address_form.select :state, options_for_select(Address::STATE_UF, selected: @event.address.state), {}, { class: 'form-select form-select-sm' } %>
                </div>
              </div>
            </div>

            <div class="form-group mb-2">
              <%= address_form.label :complement, 'Complemento', class: 'form-label' %>
              <%= address_form.text_field :complement, class: 'form-control form-control-sm', placeholder: 'Casa / Apto.' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
  </div>
</div>

<script>
  $(document).ready(function() {
    $('#zip_not_found').hide();

    let debounce_timeout;

    $('#event_address_attributes_zip_code').on('input', function() {
      clearTimeout(debounce_timeout);

      let code = $(this).val().replace(/\D/g, '');

      debounce_timeout = setTimeout(function() {
        if (code.length == 8) {
          $('#loading').fadeIn(200);

          $.get(`https://viacep.com.br/ws/${code}/json`, function(resp) {
            if (!resp.erro) {
              $('#zip_not_found').hide();
              $('#event_address_attributes_street').val(resp.logradouro)
              $('#event_address_attributes_neighborhood').val(resp.bairro)
              $('#event_address_attributes_city').val(resp.localidade)
              $('#event_address_attributes_state').val(resp.uf)
              $('#event_address_attributes_complement').val(resp.complemento)
            } else {
              $('#zip_not_found').show();
            }
          }).fail(function() {
            alert('Erro ao consultar CEP');
          }).always(function() {
           $('#loading').fadeOut(200);
          });
        }
      });
    });
  });
</script>
